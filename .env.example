# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Database & Cache / Queue
DATABASE_URL=sqlite:///./data/stock_assistant.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# AI Harness & LLM Provider
# Options: mock (deterministic offline analyst), gemini, openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Data Providers (MCP)
# Options: auto (live with fixture fallback), live, fixture
MARKET_DATA_MODE=auto
SEC_EDGAR_USER_AGENT=StockMarketAssistant contact@example.com

# Python Sandbox
# Options: docker (isolated container), local_restricted (dev fallback without Docker)
SANDBOX_MODE=docker
SANDBOX_DOCKER_IMAGE=stock-assistant-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=15

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
